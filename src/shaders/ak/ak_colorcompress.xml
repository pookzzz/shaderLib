<?xml version="1.0" encoding="utf-8"?>
<ShaderNodePreset 
	SupportsAdaptiveDegradation="False" 
	SupportsAction="False" 
	SupportsTransition="False" 
	SupportsTimeline="False" 
	TimelineUseBack="False" 
	MatteProvider="False" 
	CommercialUsePermitted="True" 
	ShaderType="Matchbox" 
	SoftwareVersion="2017.0.0" 
	LimitInputsToTexture="True" 
	Version="1" 
	Description="Color Compressor through hue rotation around reference point
	
	Use to pull hue, sat, and exposure of the entire image closer to the values of the reference
	color. Value of 0 is neutral. At maximum compression whole image will be solid of the reference
	color. It honors an input matte to enable keying and masking of the effect.

	The curve can be used to bias the effect strenght closer or further from the target color.
	
	Most common use cases are to remove color variations in skin and products. Default target
	color is skintone for that reason.
	
	This should look familiar to anyone who used Resolves Color Compressor.
	
	Matchbox shader by Jan Klier https://www.janklier.com"
	Name="AK Color Compressor">
   <Shader GridSubdivision="1" OutputBitDepth="Output" Index="1">
	<Uniform 
		Index="0" 
		NoInput="Error" 
		DisplayName="Source"
		Mipmaps="False"
		GL_TEXTURE_WRAP_T="GL_REPEAT"
		GL_TEXTURE_WRAP_S="GL_REPEAT"
		GL_TEXTURE_MAG_FILTER="GL_NEAREST"
		GL_TEXTURE_MIN_FILTER="GL_NEAREST"
		Type="sampler2D"
		Name="front">
	</Uniform>
	<Uniform 
		Index="1" 
		NoInput="White" 
		InputType="Matte"
		DisplayName="Matte"
		Mipmaps="False"
		GL_TEXTURE_WRAP_T="GL_REPEAT"
		GL_TEXTURE_WRAP_S="GL_REPEAT"
		GL_TEXTURE_MAG_FILTER="GL_LINEAR"
		GL_TEXTURE_MIN_FILTER="GL_LINEAR"
		Type="sampler2D"
		Name="matte">
	</Uniform>
	<Uniform
		Type="vec3"
		ValueType="Colour"
		Action3DWidget="False"
		IconType="None"
		ToolTip=""
		DisplayName="Target Color"
		ChannelName="color_ref"
		Inc="0.01"
		Row="0"
		Col="0"
		Page="0"
		Name="color_target">
		<SubUniform ResDependent="None" Min="-1000.0" Max="1000.0" Default="0.875"></SubUniform>
		<SubUniform ResDependent="None" Min="-1000.0" Max="1000.0" Default="0.696"></SubUniform>
		<SubUniform ResDependent="None" Min="-1000.0" Max="1000.0" Default="0.579"></SubUniform>
	</Uniform>
	<Uniform
		ResDependent="None"
		Max="100.0"
		Min="0.0"
		Default="0.0"
		Inc="1.0"
		ToolTip="in percent"
		Row="1"
		Col="0"
		Page="0"
		DisplayName="Hue Compression"
		Type="float"
		Name="hue_strength">
	</Uniform>
	<Uniform
		ResDependent="None"
		Max="100.0"
		Min="0.0"
		Default="0.0"
		Inc="1.0"
		ToolTip="in percent"
		Row="2"
		Col="0"
		Page="0"
		DisplayName="Sat Compression"
		Type="float"
		Name="sat_strength">
	</Uniform>
	<Uniform
		ResDependent="None"
		Max="100.0"
		Min="0.0"
		Default="0.0"
		Inc="1.0"
		ToolTip="in percent"
		Row="3"
		Col="0"
		Page="0"
		DisplayName="Exposure Compression"
		Type="float"
		Name="lum_strength">
	</Uniform>
	<Uniform
		ResDependent="None"
		Max="100.0"
		Min="0.0"
		Default="0.0"
		Inc="1.0"
		ToolTip="Range"
		Row="0"
		Col="1"
		Page="0"
		DisplayName="Hue Compression Strength"
		Type="int"
		Background="2"
		ValueType="Curve"
		Name="strength_curve">
	</Uniform>
    </Shader>
   <Page Name="Main" Page="0">
      <Col Name="Setup" Col="0" Page="0">
      </Col>
      <Col Name="Strength" Col="1" Page="0">
      </Col>
    </Page>
</ShaderNodePreset>
